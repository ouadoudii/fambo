{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fambo",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-10-21",
  "assets": {
    "directory": "./cloudflare/public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "vars": {
    "KV_REST_API_URL": "https://singular-moth-70968.upstash.io"
  },
  "observability": {
    "enabled": true
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
