{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fambo-family",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-10-21",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  }
}
